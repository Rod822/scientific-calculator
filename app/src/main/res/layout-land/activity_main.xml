<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/previous_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:ellipsize="start"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/input_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_weight="1"
        android:gravity="end|bottom"
        android:hint="@string/button_0"
        android:maxLines="3"
        android:textSize="44sp"
        app:autoSizeMaxTextSize="44sp"
        app:autoSizeMinTextSize="16sp"
        app:autoSizeTextType="uniform" />

    <GridLayout
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:layout_weight="2"
        android:columnCount="8"
        android:rowCount="4">

        <Button
            android:id="@+id/button_angle"
            style="@style/CalculatorButton"
            android:text="@string/degrees" />

        <Button
            android:id="@+id/button_pi"
            style="@style/CalculatorButton"
            android:tag="π"
            android:text="@string/button_pi" />

        <Button
            android:id="@+id/button_e"
            style="@style/CalculatorButton"
            android:tag="e"
            android:text="@string/button_e" />

        <Button
            android:id="@+id/button_clear"
            style="@style/CalculatorButton"
            android:text="@string/button_clear" />

        <Button
            android:id="@+id/button_7"
            style="@style/CalculatorButton"
            android:tag="7"
            android:text="@string/button_7" />

        <Button
            android:id="@+id/button_8"
            style="@style/CalculatorButton"
            android:tag="8"
            android:text="@string/button_8" />

        <Button
            android:id="@+id/button_9"
            style="@style/CalculatorButton"
            android:tag="9"
            android:text="@string/button_9" />

        <Button
            android:id="@+id/button_multiply"
            style="@style/CalculatorButton"
            android:tag="×"
            android:text="@string/button_multiply" />

        <Button
            android:id="@+id/button_sin"
            style="@style/CalculatorButton"
            android:tag="sin("
            android:text="@string/button_sin" />

        <Button
            android:id="@+id/button_cos"
            style="@style/CalculatorButton"
            android:tag="cos("
            android:text="@string/button_cos" />

        <Button
            android:id="@+id/button_tan"
            style="@style/CalculatorButton"
            android:tag="tan("
            android:text="@string/button_tan" />

        <Button
            android:id="@+id/button_delete"
            style="@style/CalculatorButton"
            android:text="@string/button_delete" />

        <Button
            android:id="@+id/button_4"
            style="@style/CalculatorButton"
            android:tag="4"
            android:text="@string/button_4" />

        <Button
            android:id="@+id/button_5"
            style="@style/CalculatorButton"
            android:tag="5"
            android:text="@string/button_5" />

        <Button
            android:id="@+id/button_6"
            style="@style/CalculatorButton"
            android:tag="6"
            android:text="@string/button_6" />

        <Button
            android:id="@+id/button_minus"
            style="@style/CalculatorButton"
            android:tag="−"
            android:text="@string/button_minus" />

        <Button
            android:id="@+id/button_ln"
            style="@style/CalculatorButton"
            android:tag="ln("
            android:text="@string/button_ln" />

        <Button
            android:id="@+id/button_log"
            style="@style/CalculatorButton"
            android:tag="log("
            android:text="@string/button_log" />

        <Button
            android:id="@+id/button_sqrt"
            style="@style/CalculatorButton"
            android:tag="√("
            android:text="@string/button_sqrt" />

        <Button
            android:id="@+id/button_power"
            style="@style/CalculatorButton"
            android:tag="^"
            android:text="@string/button_power" />

        <Button
            android:id="@+id/button_1"
            style="@style/CalculatorButton"
            android:tag="1"
            android:text="@string/button_1" />

        <Button
            android:id="@+id/button_2"
            style="@style/CalculatorButton"
            android:tag="2"
            android:text="@string/button_2" />

        <Button
            android:id="@+id/button_3"
            style="@style/CalculatorButton"
            android:tag="3"
            android:text="@string/button_3" />

        <Button
            android:id="@+id/button_plus"
            style="@style/CalculatorButton"
            android:tag="+"
            android:text="@string/button_plus" />

        <Button
            android:id="@+id/button_open"
            style="@style/CalculatorButton"
            android:tag="("
            android:text="@string/button_open" />

        <Button
            android:id="@+id/button_close"
            style="@style/CalculatorButton"
            android:tag=")"
            android:text="@string/button_close" />

        <Button
            android:id="@+id/button_factorial"
            style="@style/CalculatorButton"
            android:tag="!"
            android:text="@string/button_factorial" />

        <Button
            android:id="@+id/button_divide"
            style="@style/CalculatorButton"
            android:tag="÷"
            android:text="@string/button_divide" />

        <Button
            android:id="@+id/button_0"
            style="@style/CalculatorButton"
            android:tag="0"
            android:text="@string/button_0" />

        <Button
            android:id="@+id/button_dot"
            style="@style/CalculatorButton"
            android:tag="."
            android:text="@string/button_dot" />

        <Button
            android:id="@+id/button_equals"
            style="@style/CalculatorButton.Equals"
            android:layout_columnSpan="2"
            android:text="@string/button_equals" />
    </GridLayout>

</LinearLayout>
